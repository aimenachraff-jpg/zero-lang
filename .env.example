# ZERO-LANG Environment Variables
# Copy this to .env.local and fill in your values.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Alternative name (newer Supabase convention):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side only. Used by scripts/seed.mjs to upsert curriculum content.
# Never expose this key to the browser and never commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
